# Copie estas variáveis para Railway > Settings > Variables
# (não suba um arquivo .env de verdade pro GitHub)

NOME_BOT=Meu Bot
NOME_DONO=Seu Nome
NUMERO_DONO=5511999999999
PREFIXO=!

# Caminho da sessão. Se usar um Volume no Railway, aponte pra ele, ex: /data/auth_info
AUTH_DIR=./auth_info

# Senha do painel web de pareamento — TROQUE ISSO
SENHA_PAINEL=escolha-uma-senha-forte

# IA (opcional) — deixe em branco pra desativar o comando !ia
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen-2.5-72b-instruct
